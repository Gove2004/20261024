{
  "name": "guoba-must-die",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "锅巴必须死 —— 反向肉鸽网页游戏（TypeScript + Vite + PixiJS 8）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node tools/simulate.mjs",
    "art:clean": "python tools/art/clean.py",
    "art:pack": "python tools/art/pack.py"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
