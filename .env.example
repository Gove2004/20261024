# ============================================================
#  《锅巴必须死》环境变量模板
#  用法：cp .env.example .env.local  然后填入你自己的 Key
#  注意：.env.local 已被 .gitignore 忽略，不要提交真实 Key
# ============================================================

# ── 生成式媒体（贴图 / BGM / 配音 / 视频）────────────────────
# 平台：https://credits.openai-next.com
# 只被 tools/media/*.mjs 读取；前端代码永远不要直连此 API
CREDIT_MEDIA_API_KEY=sk-请替换成你自己的Key
CREDIT_API_BASE=https://api.openai-next.com

# ── 模型选择（可留空，留空则用脚本内置默认值）────────────────
# 出图：gpt-image-2 / gpt-image-1.5 / gemini-3-pro-image / doubao-seedream-5-0-pro-260628
IMG_MODEL=gpt-image-2
# 角色一致性（支持参考图）：gemini-3-pro-image / gemini-nano-banana-2.1
IMG_MODEL_CHAR=gemini-3-pro-image
# 音乐：suno-v4.5
MUSIC_MODEL=suno-v4.5
# 配音：tts-1 / speech-1.6
TTS_MODEL=tts-1
# 视频（可选）：sora-2 / veo3.1-fast
VIDEO_MODEL=sora-2

# ── 生成参数 ────────────────────────────────────────────────
# 并发数（实测单张约 22 秒，建议 3-4）
GEN_CONCURRENCY=3
# 失败重试次数
GEN_RETRIES=2

# ── 本地开发 ────────────────────────────────────────────────
# 调试面板（F3 打开帧率/实体数）
VITE_DEBUG=true
